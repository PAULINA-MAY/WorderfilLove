---
import IconoTemporada from './IconoTemporada.astro';
---

<!-- Línea dibujada a mano con el ícono de la temporada al centro. -->
<div class="contenedor flex items-center gap-6 text-ink/40" aria-hidden="true">
  <svg class="h-3 flex-1" viewBox="0 0 400 12" preserveAspectRatio="none">
    <path d="M2 7 C 60 2, 110 11, 170 6 S 300 2, 398 7" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>
  <IconoTemporada tamano={32} />
  <svg class="h-3 flex-1" viewBox="0 0 400 12" preserveAspectRatio="none">
    <path d="M2 6 C 90 11, 150 2, 230 7 S 340 10, 398 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>
</div>
