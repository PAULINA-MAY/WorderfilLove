---
import Icono, { type NombreIcono } from './Icono.astro';
import { enlaceWhatsApp, mensajeGeneral, sitio } from '../data/sitio';

const medios: { icono: NombreIcono; etiqueta: string; valor: string; href?: string; destacado?: boolean }[] = [
  { icono: 'whatsapp', etiqueta: 'WhatsApp', valor: `${sitio.whatsappVisible} · Cotiza aquí`, href: enlaceWhatsApp(mensajeGeneral), destacado: true },
  { icono: 'facebook', etiqueta: 'Facebook', valor: sitio.facebookVisible, href: sitio.facebook },
  { icono: 'correo', etiqueta: 'Correo', valor: sitio.correo, href: `mailto:${sitio.correo}` },
  { icono: 'ubicacion', etiqueta: 'Dónde encontrarnos', valor: sitio.direccion, href: sitio.mapa },
  { icono: 'horario', etiqueta: 'Horario', valor: sitio.horario },
];
---

<section id="contacto" class="bg-soft">
  <div class="revelar contenedor grid items-center gap-10 py-16 md:grid-cols-[1fr_minmax(0,560px)] md:gap-20 md:py-24">
    <div class="flex flex-col gap-6 md:gap-7">
      <p class="nota">¡te esperamos!</p>
      <h2 class="text-4xl leading-[1.05] md:text-[52px]">Escríbenos o <em>visítanos</em></h2>
      <p class="max-w-[480px] opacity-80">
        Cotiza por WhatsApp o pasa a conocer las piezas en persona. Apartamos tu pedido y lo pagas al recogerlo.
      </p>
      <ul class="flex flex-col gap-3">
        {medios.map((m) => {
          const Tag = m.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                href={m.href}
                target={m.href && !m.href.startsWith('mailto') ? '_blank' : undefined}
                rel={m.href ? 'noopener' : undefined}
                class:list={[
                  'flex items-center gap-4 rounded-2xl px-5 py-4 transition-colors',
                  m.destacado ? 'papel papel-vivo acento bg-ink text-bg' : 'border-[1.5px] border-dashed border-ink/40 bg-bg',
                  m.href && !m.destacado && 'hover:border-accent hover:text-accent-texto',
                ]}
              >
                <span class:list={[!m.destacado && 'text-accent']}><Icono nombre={m.icono} tamano={22} /></span>
                <span class="flex flex-col gap-0.5">
                  <span class:list={['etiqueta', m.destacado && 'text-bg']}>{m.etiqueta}</span>
                  <span class="text-sm md:text-base">{m.valor}</span>
                </span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Mapa provisional: abre la ubicación en Google Maps. -->
    <a
      href={sitio.mapa}
      target="_blank"
      rel="noopener"
      class="papel relative flex aspect-[14/13] items-center justify-center overflow-hidden rounded-[24px] bg-bg"
      aria-label="Ver ubicación en Google Maps"
    >
      <svg class="absolute inset-0 size-full text-line" preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
        <g stroke="currentColor" stroke-width="0.3" fill="none">
          <path d="M-10 20 110 70M-10 45 110 95M-10 -5 110 45M-10 70 110 120" />
          <path d="M20 -10 -10 110M55 -10 25 110M90 -10 60 110" />
        </g>
        <path d="M-10 33 110 83" stroke="currentColor" stroke-width="2.2" />
      </svg>
      <span class="relative flex flex-col items-center gap-3 text-accent">
        <Icono nombre="ubicacion" tamano={56} />
        <span class="etiqueta text-ink">Wonderful Love · Centro, Mérida</span>
      </span>
    </a>
  </div>
</section>
