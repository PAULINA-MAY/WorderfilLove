---
import Icono from './Icono.astro';
import { enlaceWhatsApp, mensajeGeneral } from '../data/sitio';
---

<a
  href={enlaceWhatsApp(mensajeGeneral)}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="papel papel-vivo fixed right-4 bottom-6 z-40 flex size-14 items-center justify-center rounded-full bg-whatsapp text-white md:right-10 md:bottom-8 md:size-16"
>
  <Icono nombre="whatsapp" tamano={30} />
</a>
