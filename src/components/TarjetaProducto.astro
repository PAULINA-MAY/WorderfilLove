---
import { Image } from 'astro:assets';
import Ilustracion from './Ilustracion.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import type { Producto } from '../data/productos';

interface Props {
  producto: Producto;
  /** Más compacta en celular, para que quepan dos tarjetas por fila. */
  compacta?: boolean;
  class?: string;
}
const { producto, compacta = false, class: clase } = Astro.props;
---

<article
  class:list={['tarjeta-anim borde-metal papel-vivo flex flex-col overflow-hidden rounded-[20px] bg-bg', clase]}
  data-producto
  data-tipo={producto.tipo}
  data-temporada-producto={producto.temporada}
>
  <div class="flex aspect-square items-center justify-center overflow-hidden border-b border-line bg-soft">
    {producto.foto ? (
      <Image
        src={producto.foto.src}
        alt={producto.foto.alt}
        widths={[360, 540, 720]}
        sizes="(min-width: 768px) 420px, 78vw"
        loading="lazy"
        class="size-full object-cover"
        style={producto.foto.posicion && `object-position: ${producto.foto.posicion}`}
      />
    ) : (
      <Ilustracion tipo={producto.ilustracion} class="w-2/5 opacity-60" />
    )}
  </div>
  <div class:list={['flex flex-1 flex-col', compacta ? 'gap-1.5 p-3.5 sm:gap-2 sm:p-6' : 'gap-2 p-6']}>
    <h3 class:list={['leading-tight', compacta ? 'text-base break-words hyphens-auto sm:text-2xl' : 'text-2xl']}>{producto.nombre}</h3>
    <p class:list={['opacity-75', compacta ? 'line-clamp-2 text-xs sm:line-clamp-none sm:text-sm' : 'text-sm']}>{producto.frase}</p>
    <div class:list={['mt-auto', compacta ? 'pt-2 sm:pt-3' : 'pt-3']}>
      <BotonWhatsApp producto={producto.nombre} compacto={compacta} />
    </div>
  </div>
</article>
