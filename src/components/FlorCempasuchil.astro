---
// Flor de cempasúchil vista de frente: dos coronas de pétalos y el centro.
interface Props {
  tam?: number;
  class?: string;
}
const { tam = 24, class: clase } = Astro.props;
const exteriores = Array.from({ length: 12 }, (_, i) => i * 30);
const interiores = Array.from({ length: 8 }, (_, i) => i * 45 + 22.5);
---

<svg class={clase} width={tam} height={tam} viewBox="0 0 40 40" aria-hidden="true">
  {exteriores.map((a) => <ellipse cx="20" cy="9" rx="4.5" ry="8" fill="#e8761a" transform={`rotate(${a} 20 20)`} />)}
  {interiores.map((a) => <ellipse cx="20" cy="12" rx="3.8" ry="6" fill="#f29a1f" transform={`rotate(${a} 20 20)`} />)}
  <circle cx="20" cy="20" r="6" fill="#f7b32b" />
</svg>
