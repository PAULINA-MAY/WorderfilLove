---
// Íconos de línea del diseño en Figma. Usan currentColor para tomar el color del tema.
const petalos = [0, 45, 90, 135, 180, 225, 270, 315]
  .map((a) => `<ellipse cx="12" cy="6" rx="2" ry="3.3" transform="rotate(${a} 12 12)"/>`)
  .join('');

const iconos = {
  // Temporadas
  halloween: '<path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1"/><path d="M12 6.5l3.9 1.6 1.6 3.9-1.6 3.9-3.9 1.6-3.9-1.6L6.5 12l1.6-3.9z"/><path d="M12 9.5l1.8.7.7 1.8-.7 1.8-1.8.7-1.8-.7-.7-1.8.7-1.8z"/>',
  muertos: petalos + '<circle cx="12" cy="12" r="2.5"/>',
  navidad: '<path d="M12 22V3"/><path d="M12 7L8 4M12 7l4-3M12 11L7 7.5M12 11l5-3.5M12 15l-6-4M12 15l6-4M12 19l-6.5-4M12 19l6.5-4"/>',
  amor: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
  primavera: '<path d="M12 21v-9"/><path d="M12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/><path d="M12 14c0-3-2.5-5.5-6-5.5 0 3 2.5 5.5 6 5.5z"/>',
  mamas: '<path d="M12 21v-8"/><path d="M7 5l2.5 2.5L12 4l2.5 3.5L17 5v4a5 5 0 0 1-10 0z"/><path d="M12 17c-2-2-4.5-2-6-1.5M12 18c2-2 4.5-2 6-1.5"/>',
  papas: '<path d="M3 7l7 3.5v3L3 17z"/><path d="M21 7l-7 3.5v3l7 3.5z"/><rect x="10" y="10" width="4" height="4" rx="1"/>',
  mexicano: '<path d="M2 4h20"/><path d="M4 4v12l2-2 2 2 2-2 2 2 2-2 2 2 2-2 2 2V4"/><circle cx="12" cy="9" r="2"/><path d="M7 8h1M16 8h1M7 11h1M16 11h1"/>',
  general: '<path d="M12 3c3 3.5 5 6 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5 0 1.5 1 2.5 2 2.5 0-2.5 0-4.5 1-7z"/>',
  // Interfaz
  whatsapp: '<path d="M4 20l1.3-3.9A8 8 0 1 1 8 18.8z"/><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .8c-1-.5-1.9-1.4-2.4-2.4l.8-1-1-2z"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>',
  correo: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  ubicacion: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  horario: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6L6 18"/>',
  'flecha-derecha': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'flecha-abajo': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  // Proceso
  aroma: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  verter: '<path d="M6 8h10v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/><path d="M16 10h2a2 2 0 0 1 0 4h-2"/><path d="M9 3v2M12 2v3"/>',
  pintar: '<path d="M19 3l-9 9"/><path d="M10 12c-3 0-5 2-5 5 0 1.5-1 2.5-2 3 4 1 9 0 9-5z"/>',
  empacar: '<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 13h18M12 9v12"/><path d="M12 9c-2-4-6-4-6-1.5S12 9 12 9zM12 9c2-4 6-4 6-1.5S12 9 12 9z"/>',
};

export type NombreIcono = keyof typeof iconos;

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  class?: string;
}
const { nombre, tamano = 24, class: clase } = Astro.props;
---

<svg
  class:list={['icono shrink-0', clase]}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={iconos[nombre]}
/>
