---
import TarjetaResena from './TarjetaResena.astro';
import { resenas } from '../data/resenas';
---

<section class="revelar contenedor flex flex-col gap-10 py-16 md:gap-12 md:py-24">
  <div class="flex flex-col gap-3">
    <p class="nota">con cariño</p>
    <h2 class="text-4xl leading-[1.05] md:text-[52px]"><em>Lo que dicen</em> de nosotros</h2>
  </div>
  <div class="carrusel -mx-5 flex gap-5 overflow-x-auto px-5 pt-1 pb-3 md:-mx-20 md:px-20 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-8 lg:overflow-visible lg:px-0">
    {resenas.map((r) => (
      <TarjetaResena {...r} class="w-[80%] shrink-0 md:w-[44%] lg:w-auto" />
    ))}
  </div>
</section>
