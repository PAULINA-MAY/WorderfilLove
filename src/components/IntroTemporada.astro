---
import Icono from './Icono.astro';

// Posiciones fijas (no aleatorias) para que el HTML sea igual en cada build.
const petalos = Array.from({ length: 16 }, (_, i) => ({
  left: (i * 37) % 100,
  delay: ((i * 7) % 10) / 10,
  tamano: 18 + ((i * 5) % 14),
}));
---

<div class="intro intro-halloween" data-solo="halloween" aria-hidden="true">
  <span class="hilo"></span>
  <Icono nombre="halloween" tamano={80} />
</div>

<div class="intro intro-muertos" data-solo="muertos" aria-hidden="true">
  {petalos.map((p) => (
    <span class="petalo" style={`left:${p.left}%;animation-delay:${p.delay}s`}>
      <Icono nombre="muertos" tamano={p.tamano} />
    </span>
  ))}
</div>

<div class="intro intro-navidad" data-solo="navidad" aria-hidden="true">
  <Icono nombre="navidad" tamano={80} />
</div>

<div class="intro intro-amor" data-solo="amor" aria-hidden="true">
  <Icono nombre="amor" tamano={80} />
</div>

<div class="intro intro-primavera" data-solo="primavera" aria-hidden="true">
  <Icono nombre="primavera" tamano={80} />
</div>

<div class="intro intro-mamas" data-solo="mamas" aria-hidden="true">
  <span class="mitad izq"></span>
  <span class="mitad der"></span>
  <span class="liston"></span>
  <Icono nombre="mamas" tamano={80} />
</div>

<div class="intro intro-papas" data-solo="papas" aria-hidden="true">
  <Icono nombre="papas" tamano={80} />
  <span class="trazo"></span>
</div>

<div class="intro intro-mexicano" data-solo="mexicano" aria-hidden="true">
  <Icono nombre="mexicano" tamano={120} />
</div>

<div class="intro intro-general" data-solo="general" aria-hidden="true">
  <Icono nombre="general" tamano={80} />
</div>
