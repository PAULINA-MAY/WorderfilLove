---
import Icono from './Icono.astro';
import { enlaceWhatsApp, mensajeGeneral } from '../data/sitio';

interface Props {
  actual: 'inicio' | 'productos' | 'historia';
}
const { actual } = Astro.props;
const links = [
  { id: 'inicio', texto: 'Inicio', href: '/' },
  { id: 'productos', texto: 'Productos', href: '/productos' },
  { id: 'historia', texto: 'Nuestra historia', href: '/historia' },
];
---

<!-- Píldora flotante, como recortada en papel. Se encoge al hacer scroll (ver scripts/menu.ts). -->
<header class="sticky top-0 z-30 px-4 pt-3 md:px-8 md:pt-4" data-navbar>
  <div class="papel mx-auto max-w-[1180px] rounded-[28px] bg-bg">
    <nav
      class="flex items-center justify-between py-2.5 pr-2.5 pl-6 transition-[padding] duration-300 [[data-navbar].encogido_&]:py-1.5"
      aria-label="Principal"
    >
      <a href="/" class="font-display text-[22px] font-semibold italic md:text-2xl">Wonderful Love</a>

      <div class="hidden items-center gap-1 md:flex">
        <ul class="flex items-center">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.id === actual ? 'page' : undefined}
                class="relative rounded-full px-4 py-2 text-[15px] transition-colors hover:text-accent-texto aria-[current=page]:text-accent-texto"
              >
                {l.texto}
                {l.id === actual && (
                  <svg class="absolute right-4 -bottom-0.5 left-4 h-1.5 w-[calc(100%-2rem)]" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M1 4 C 30 1, 60 6, 99 2" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
        <a
          href={enlaceWhatsApp(mensajeGeneral)}
          target="_blank"
          rel="noopener"
          class="ml-2 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-[15px] font-medium text-bg transition-colors hover:bg-accent"
        >
          <Icono nombre="whatsapp" tamano={18} />
          Cotizar
        </a>
      </div>

      <button
        type="button"
        class="group flex size-11 items-center justify-center rounded-full bg-ink text-bg md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-boton
      >
        <Icono nombre="menu" tamano={22} class="group-aria-expanded:hidden" />
        <Icono nombre="cerrar" tamano={22} class="hidden group-aria-expanded:block" />
      </button>
    </nav>

    <div id="menu-movil" class="hidden flex-col gap-1 border-t border-line px-6 pt-2 pb-6 md:hidden" data-menu>
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.id === actual ? 'page' : undefined}
              class="flex items-center justify-between py-3.5 font-display text-[28px] aria-[current=page]:text-accent-texto"
            >
              {l.texto}
              {l.id === actual && <span class="nota text-xl">aquí estás</span>}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={enlaceWhatsApp(mensajeGeneral)}
        target="_blank"
        rel="noopener"
        class="mt-3 flex items-center justify-center gap-2.5 rounded-full bg-ink px-5 py-3.5 font-medium text-bg"
      >
        <Icono nombre="whatsapp" tamano={20} />
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  import { iniciarMenu } from '../scripts/menu';
  iniciarMenu();
</script>
