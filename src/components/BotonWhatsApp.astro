---
import Icono from './Icono.astro';
import { enlaceWhatsApp, mensajeProducto } from '../data/sitio';

interface Props {
  producto: string;
  /** En celular, botón más chico que solo dice "Cotizar" (para tarjetas en dos columnas). */
  compacto?: boolean;
}
const { producto, compacto = false } = Astro.props;
---

<a
  href={enlaceWhatsApp(mensajeProducto(producto))}
  target="_blank"
  rel="noopener"
  class:list={[
    'flex w-full items-center justify-center rounded-full bg-ink font-medium text-bg transition-colors duration-300 hover:bg-hover hover:text-hover-texto',
    compacto ? 'gap-1.5 px-3 py-2 text-[13px] sm:gap-2.5 sm:px-5 sm:py-3 sm:text-[15px]' : 'gap-2.5 px-5 py-3 text-[15px]',
  ]}
  aria-label={`Cotizar ${producto} por WhatsApp`}
>
  <Icono nombre="whatsapp" tamano={compacto ? 16 : 20} />
  {compacto ? (
    <>
      <span class="sm:hidden">Cotizar</span>
      <span class="hidden sm:inline">Cotizar por WhatsApp</span>
    </>
  ) : (
    'Cotizar por WhatsApp'
  )}
</a>
