---
import Boton from './Boton.astro';
import TarjetaProducto from './TarjetaProducto.astro';
import { temporadas } from '../data/temporadas';
import { productoPorId } from '../data/productos';
---

<section class="revelar contenedor flex flex-col gap-10 py-16 md:gap-12 md:py-24">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-3">
      <p class="nota">recién salidas del taller</p>
      <h2 class="text-4xl leading-[1.05] md:text-[52px]">
        <span data-solo="general">Nuestros <em>favoritos</em></span>
        {temporadas.filter((t) => t.clave !== 'general').map((t) => (
          <span data-solo={t.clave}>Lo de esta <em>temporada</em></span>
        ))}
      </h2>
    </div>
    <div class="hidden md:block"><Boton href="/productos" variante="secundario">Ver todo el catálogo</Boton></div>
  </div>

  {temporadas.map((t) => (
    <div data-solo={t.clave} class="carrusel -mx-5 flex gap-5 overflow-x-auto px-5 pt-1 pb-3 md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0">
      {t.destacados.map((id) => (
        <TarjetaProducto producto={productoPorId(id)} class="w-[78%] shrink-0 md:w-auto" />
      ))}
    </div>
  ))}

  <Boton href="/productos" variante="secundario" class="md:hidden">Ver todo el catálogo</Boton>
</section>
