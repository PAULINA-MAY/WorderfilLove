---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BotonFlotante from '../components/BotonFlotante.astro';
import Particulas from '../components/Particulas.astro';
import IntroMarca from '../components/IntroMarca.astro';
import { claveParaFecha, rangosPlanos, temporadas } from '../data/temporadas';
import { paleta } from '../data/contraste';
import { sitio } from '../data/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  actual: 'inicio' | 'productos' | 'historia';
}
const { titulo, descripcion = sitio.descripcion, actual } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · Velas y figurillas hechas a mano`;

const claves = temporadas.map((t) => t.clave);

// Paleta y tema de cada temporada, y regla para ocultar el contenido de las que no tocan.
const cssTemporadas = temporadas
  .map((t) => {
    const p = paleta(t.colores);
    const tope = p.tope ? `;--salmon-claro:${p.tope}` : '';
    const tema = t.tema
      ? `;--borde-tema:${t.tema.borde};--puntos:${t.tema.puntos};--icono:${t.tema.icono};--hover:${t.tema.hover};--hover-texto:${t.tema.hoverTexto};--hover-borde:${t.tema.hoverBorde}`
      : '';
    return `html[data-temporada="${t.clave}"]{--bg:${p.bg};--soft:${p.soft};--ink:${p.ink};--accent:${p.accent};--accent-texto:${p.accentTexto}${tope}${tema}}`;
  })
  .join('');
const cssSolo = claves
  .map((c) => `html:not([data-temporada="${c}"]) [data-solo="${c}"]{display:none!important}`)
  .join('');

// Corre antes del primer pintado: elige la temporada (o la de ?temporada=) y decide si
// se muestra la intro "Wonderful Love" (solo la primera vez en este navegador, o con ?intro).
// `claveParaFecha` es la misma función que cubren las pruebas.
const scriptTemporada = `(function(){
var claveParaFecha=${claveParaFecha.toString()};
var rangos=${JSON.stringify(rangosPlanos)};
var claves=${JSON.stringify(claves)};
var h=document.documentElement,c=null;
try{
  var q=new URLSearchParams(location.search).get('temporada');
  if(q==='auto')sessionStorage.removeItem('wl-temporada');
  else if(claves.indexOf(q)>=0)sessionStorage.setItem('wl-temporada',q);
  c=sessionStorage.getItem('wl-temporada');
}catch(e){}
if(claves.indexOf(c)<0){var d=new Date();c=claveParaFecha(rangos,d.getMonth()+1,d.getDate());}
h.dataset.temporada=c;h.classList.add('js');
try{if((!localStorage.getItem('wl-intro')||/[?&]intro(=|&|$)/.test(location.search))&&!matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('con-intro');}catch(e){}
})();`;
---

<!doctype html>
<html lang="es-MX" data-temporada="general">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_MX" />
    <script is:inline set:html={scriptTemporada} />
    <style is:inline set:html={cssTemporadas + cssSolo}></style>
  </head>
  <body>
    <IntroMarca />
    <Navbar actual={actual} />
    <main>
      <slot />
    </main>
    <Footer />
    <BotonFlotante />
    <Particulas />

    <script>
      import { iniciarRevelar } from '../scripts/revelar';
      import { iniciarIntro } from '../scripts/intro';
      iniciarRevelar();
      iniciarIntro();
    </script>
  </body>
</html>
